NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27019/teamboard?replicaSet=rs0
APP_URL=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# 900 = 15 min. Set to 30 in dev to watch the silent refresh work (Day 4).
ACCESS_TOKEN_TTL_SEC=900

# Seed (npm run seed): the demo accounts' password. Production also needs SEED_ALLOW_PROD=yes.
# SEED_DEMO_PASSWORD=Demo1234!

# Public demo (the live site sets DEMO_MODE=true): one-click role logins on the login page,
# locked demo accounts (no password/profile changes), a protected /w/acme workspace, and an
# automatic rebuild of the demo data once it is DEMO_RESET_HOURS old (0 = never).
# DEMO_MODE=false
# DEMO_RESET_HOURS=24
